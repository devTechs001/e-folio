# Frontend Environment Variables
# Copy this file to .env and fill in your values

# === DEVELOPMENT ===
# Backend API URL (local development)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# === PRODUCTION ===
# Backend API URL (Render deployment)
# VITE_API_URL=https://e-folio-backend-server.onrender.com/api
# VITE_SOCKET_URL=https://e-folio-backend-server.onrender.com

# Base URL for GitHub Pages deployment (optional)
# For GitHub Pages: /repository-name
# For other hosts: /
VITE_BASE_URL=/

# Platform-specific environment variables for build
VITE_GITHUB_PAGES=false
VITE_NETLIFY=false
VITE_VERCEL=false

# Application metadata
VITE_APP_TITLE=E-Folio Pro
VITE_APP_DESCRIPTION=Modern Portfolio Platform

# Debug settings
VITE_DEBUG_TRACKING=false

# === AI SERVICES ===
# Google Gemini API Key (for AI chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# Note: For Netlify production, environment variables are set in netlify.toml
# For local .env.production file (if needed):
# Create .env.production with production URLs above
