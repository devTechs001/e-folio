# ========================================
# E-FOLIO FRONTEND ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your actual values
# All variables MUST start with VITE_ to be accessible in the app

# ========================================
# BACKEND API CONFIGURATION
# ========================================
# Production Backend URL (Render)
VITE_API_URL=https://e-folio-backend-server.onrender.com/api
VITE_SOCKET_URL=https://e-folio-backend-server.onrender.com

# Development URLs (uncomment for local development)
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000

# Base URL for routing (use / for Netlify, /e-folio/ for GitHub Pages)
VITE_BASE_URL=/

# ========================================
# PLATFORM FLAGS
# ========================================
VITE_GITHUB_PAGES=false
VITE_NETLIFY=true
VITE_VERCEL=false

# ========================================
# APPLICATION METADATA
# ========================================
VITE_APP_NAME=E-Folio Pro
VITE_APP_TITLE=E-Folio Pro
VITE_APP_DESCRIPTION=Professional Portfolio & Collaboration Platform
VITE_APP_VERSION=1.0.0

# ========================================
# ANALYTICS & TRACKING
# ========================================
VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_DEBUG_TRACKING=false

# ========================================
# ERROR TRACKING
# ========================================
VITE_SENTRY_DSN=your_sentry_dsn
VITE_SENTRY_ENVIRONMENT=production

# ========================================
# FEATURE FLAGS
# ========================================
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_COLLABORATION=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true

# ========================================
# THIRD-PARTY API KEYS (Frontend)
# ========================================
# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# reCAPTCHA
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Stripe (Public Key)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Google Gemini (if used on frontend)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# SOCIAL MEDIA LINKS
# ========================================
VITE_GITHUB_URL=https://github.com/devTechs001
VITE_LINKEDIN_URL=https://linkedin.com/in/yourprofile
VITE_TWITTER_URL=https://twitter.com/yourhandle

# ========================================
# CONTACT INFORMATION
# ========================================
VITE_CONTACT_EMAIL=devtechs842@gmail.com
VITE_SUPPORT_EMAIL=support@yourportfolio.com

# ========================================
# CDN & ASSETS
# ========================================
VITE_CDN_URL=https://cdn.yourportfolio.com
VITE_ASSETS_URL=https://assets.yourportfolio.com

# ========================================
# PERFORMANCE & OPTIMIZATION
# ========================================
VITE_ENABLE_PWA=true
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_DURATION=3600000

# ========================================
# DEBUGGING
# ========================================
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

# ========================================
# NOTES
# ========================================
# For Netlify production: Set variables in Netlify dashboard or netlify.toml
# For local development: Create .env.local with development URLs
# For production build: Create .env.production with production URLs
