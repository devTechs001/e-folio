# Render backend environment template (SAFE TO COMMIT - no real values)
# Copy to a local .env.render, fill in real values, and keep that file untracked.
# Set secrets in the Render dashboard instead of committing them.

NODE_ENV=production
NODE_VERSION=18
PORT=10000

# Set in Render dashboard (sync: false). Never commit a live connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-random-32-byte-secret>

CLIENT_URL=https://e-folio-pro.netlify.app

# Frontend build-time values (public, but still keep them here for reference)
VITE_API_URL=https://<your-backend-host>/api
VITE_SOCKET_URL=https://<your-backend-host>
GITHUB_PAGES=false
