# Render backend environment template (SAFE TO COMMIT - no real values)
# Copy to a local .env.render, fill in real values, and keep that file untracked.
# Set secrets in the Render dashboard instead of committing them.

NODE_ENV=production
NODE_VERSION=18
PORT=10000

# Set in Render dashboard (sync: false). Never commit a live connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-random-32-byte-secret>

CLIENT_URL=https://e-folio-pro.netlify.app

# Frontend build-time values (public, but still keep them here for reference)
VITE_API_URL=https://<your-backend-host>/api
VITE_SOCKET_URL=https://<your-backend-host>
GITHUB_PAGES=false

# ---------------------------------------------------------------------------
# Phase 32 — owner/admin sign-in credentials (Render dashboard ONLY)
# These are placeholders. Never put real values in this file or in Git.
# The owner login page (/login/owner) reads OWNER_EMAIL + OWNER_PASSWORD from
# the server process environment; in production a missing OWNER_EMAIL fails
# closed. ADMIN_EMAIL / ADMIN_PASSWORD are used only by the project seed
# scripts, so no demo password is compiled into source.
# ---------------------------------------------------------------------------
OWNER_EMAIL=<owner-login-email>
OWNER_PASSWORD=<strong-random-password-from-a-password-manager>
ADMIN_EMAIL=<seeded-admin-email>
ADMIN_PASSWORD=<strong-random-password-from-a-password-manager>

# Optional alternative to OWNER_PASSWORD: a bcrypt hash may be supplied as
# OWNER_PASSWORD_HASH instead. Add it manually in the Render dashboard.
