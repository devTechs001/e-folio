{
  "name": "e-folio-pro",
  "displayName": "E-Folio Pro - Advanced Portfolio Platform",
  "description": "A modern, AI-powered portfolio platform with real-time collaboration, advanced analytics, and comprehensive portfolio management tools.",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "homepage": "https://devtechs001.github.io/e-folio",
  "author": "E-Folio Team",
  "keywords": [
    "portfolio",
    "react",
    "ai",
    "collaboration",
    "real-time",
    "dashboard"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:secure": "npm run build && npm run obfuscate && npm run checksum",
    "obfuscate": "javascript-obfuscator dist --output dist --compact true --control-flow-flattening true --string-array true --string-array-shuffle true --string-array-rotate true --split-strings true --split-strings-chunk-length 3 --numbers-to-expressions true",
    "checksum": "node scripts/generate-checksums.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "cross-env GITHUB_PAGES=true npm run build",
    "deploy": "gh-pages -d dist",
    "seed-projects": "node scripts/seed-projects.js",
    "audit:endpoints": "node server/scripts/check-endpoint-parity.js",
    "audit:security": "node server/scripts/security-audit.js",
    "test:load": "node server/tests/load/smoke-load.js",
    "check": "npm run lint && npm test && npm run build",
    "test": "npm run audit:endpoints -- --strict && npm run audit:security -- --strict && node tests/dashboard-api.test.mjs && node tests/collaboration-review.test.mjs && node tests/lab-page.test.mjs && node tests/testimonial-samples.test.mjs && node tests/profile-settings-api.test.mjs && node tests/about-user-workspace.test.mjs && node tests/user-workspace-realtime.test.mjs && node tests/security-resources-page.test.mjs && node tests/live-preview-lag.test.mjs && node tests/project-showcase.test.mjs && node tests/public-fallback.test.mjs && node tests/ecommerce-link.test.mjs && node tests/homescape-link.test.mjs && node tests/project-likes.test.mjs && node tests/tracking-conflict.test.mjs && node tests/projects-page-filters.test.mjs && node tests/project-links.test.mjs && node tests/project-sync.test.mjs && node tests/review-submission.test.mjs && node tests/hook-dependency-order.test.mjs",
    "test:dashboards": "node tests/dashboard-api.test.mjs",
    "test:collaboration": "node tests/collaboration-review.test.mjs",
    "seed:lab": "node server/scripts/seedLabSamples.js",
    "seed:lab:remove": "node server/scripts/seedLabSamples.js --remove",
    "test:lab": "node tests/lab-page.test.mjs",
    "seed:testimonials": "node server/scripts/seedTestimonialSamples.js",
    "seed:testimonials:remove": "node server/scripts/seedTestimonialSamples.js --remove",
    "backup:testimonials": "node server/scripts/seedTestimonialSamples.js --export",
    "restore:testimonials": "node server/scripts/seedTestimonialSamples.js --restore",
    "testimonials:publish": "node server/scripts/seedTestimonialSamples.js --publish",
    "testimonials:unpublish": "node server/scripts/seedTestimonialSamples.js --unpublish",
    "test:testimonials": "node tests/testimonial-samples.test.mjs",
    "test:profile-settings": "node tests/profile-settings-api.test.mjs",
    "test:about-workspace": "node tests/about-user-workspace.test.mjs",
    "test:user-workspace": "node tests/user-workspace-realtime.test.mjs",
    "test:security-resources": "node tests/security-resources-page.test.mjs",
    "test:live-preview": "node tests/live-preview-lag.test.mjs",
    "seed:showcase": "node server/scripts/seedProjectShowcase.js",
    "seed:showcase:remove": "node server/scripts/seedProjectShowcase.js --remove",
    "test:project-showcase": "node tests/project-showcase.test.mjs",
    "test:public-fallback": "node tests/public-fallback.test.mjs",
    "snapshot:build": "node scripts/build-public-snapshot.mjs",
    "test:ecommerce-link": "node tests/ecommerce-link.test.mjs",
    "test:homescape-link": "node tests/homescape-link.test.mjs",
    "test:project-likes": "node tests/project-likes.test.mjs",
    "test:tracking-conflict": "node tests/tracking-conflict.test.mjs",
    "test:projects-page": "node tests/projects-page-filters.test.mjs",
    "test:project-links": "node tests/project-links.test.mjs",
    "test:project-sync": "node tests/project-sync.test.mjs",
    "test:review-submission": "node tests/review-submission.test.mjs",
    "test:hook-order": "node tests/hook-dependency-order.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@google/generative-ai": "^0.24.1",
    "ace-builds": "^1.43.4",
    "aos": "^2.3.4",
    "axios": "^1.13.1",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.16.1",
    "framer-motion": "^12.23.24",
    "html2canvas": "^1.4.1",
    "katex": "^0.16.25",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-ace": "^14.0.1",
    "react-chartjs-2": "^5.3.1",
    "react-color": "^2.19.3",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-is": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-player": "^3.3.3",
    "react-router-dom": "^7.9.4",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.3.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "socket.io-client": "^4.8.1",
    "typed.js": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "javascript-obfuscator": "^4.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^6.2.0",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
